{
  "name": "duqact-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs server.ts",
    "start": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs server.ts",
    "build": "node node_modules/vite/bin/vite.js build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:electoral": "node --experimental-vm-modules node_modules/jest/bin/jest.js electoral/ugandaElectoralRegistry.test.ts --runInBand",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "lint": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "supabase:start": "node node_modules/supabase/dist/supabase.js start",
    "supabase:reset": "node node_modules/supabase/dist/supabase.js db reset",
    "supabase:push": "node node_modules/supabase/dist/supabase.js db push",
    "supabase:seed": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs scripts/seedSupabase.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "lucide-react": "^0.477.0",
    "motion": "^13.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "jest": "^30.3.0",
    "supabase": "^2.116.0",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
