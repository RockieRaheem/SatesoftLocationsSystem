# Public values: safe to expose to the browser bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server aliases for the same public values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Never prefix this value with VITE_ and never commit a real key.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional UUID used to attribute controlled data imports to an existing auth user.
SUPABASE_IMPORT_USER_ID=

# Optional override for the Electoral Commission support JSON file.
UGANDA_ELECTORAL_DATA_PATH=Support Files/electoral-commission-2022.json

# HTTP configuration.
PORT=3000
CORS_ALLOWED_ORIGINS=
